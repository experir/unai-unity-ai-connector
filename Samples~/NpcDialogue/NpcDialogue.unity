  _displayName: Mira
  _color: {r: 0.27, g: 0.55, b: 0.9, a: 1}
  _persona: 'Mira runs the general store on the village square: cheerful, quick-witted and a little nosy. She loves village gossip and always tries to make a sale. She knows Brom the blacksmith is grumpy because of the stolen iron.'
  _greeting: Welcome, welcome! Potions, lanterns, maps, even one of Brom's swords. What can I get you?
  _maxSteps: 4
