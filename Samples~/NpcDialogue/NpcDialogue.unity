  m_Script: {fileID: 11500000, guid: 1f6462b0ea214764097fb567fbcf00a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnAI.Sample.NpcDialogue::UnAI.Samples.NpcDialogue.UnaiNpc
  _displayName: Brom
  _color: {r: 0.82, g: 0.45, b: 0.22, a: 1}
  _persona: 'Brom is the village blacksmith: gruff, proud of his work, secretly kind. Two days ago wolves attacked his iron shipment near the north bridge, and he cannot forge new blades until someone brings the iron back. He knows Mira the merchant sells his Iron Swords. He speaks plainly and calls the player ''traveller''.'
  _greeting: 'Hm. A new face. If you''re after a new blade, you''re out of luck: no iron since the wolves hit my cart at the north bridge.'
  _maxSteps: 4
